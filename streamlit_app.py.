
import streamlit as st
import unicodedata

st.set_page_config(
    page_title="THE LAST COMMIT - 12A",
    page_icon="🔐",
    layout="centered"
)

st.markdown("""
<style>
.stApp {
    background-color: #10101d;
    color: white;
}
h1, h2, h3, p, label {
    color: white !important;
}
