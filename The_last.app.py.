    st.progress(
        (st.session_state.level + 1) / len(levels)
    )

    st.caption(
        f"LEVEL {st.session_state.level + 1} / {len(levels)}"
    )

    st.markdown(
        f"<h2>{current['title']}</h2>",
        unsafe_allow_html=True
    )

    st.markdown(
        f"<div class='panel'>"
        f"<p style='color:#b7a5ff;letter-spacing:2px;'>"
        f"{current['location']}</p>"
        f"<p>{current['story'].replace(chr(10), '<br>')}</p>"
        f"</div>",
        unsafe_allow_html=True
    )

    st.markdown("### YOUR NEXT CLUE")

    st.write(current["question"])

    # IMPORTANT: Native Streamlit form.
    # It works on mobile and desktop.
    with st.form(
        key=f"answer_form_{st.session_state.level}",
        clear_on_submit=False
    ):
        answer = st.text_input(
            "Въведи своя отговор:",
            placeholder="Напиши отговора тук...",
            key=f"answer_{st.session_state.level}"
        )

        submitted = st.form_submit_button(
            "UNLOCK NEXT LEVEL"
        )

    if submitted:

        correct_answers = [
            normalize(a) for a in current["answers"]
        ]

        if normalize(answer) in correct_answers:

            st.session_state.error = False

            if st.session_state.level == len(levels) - 1:
                st.session_state.completed = True
            else:
                st.session_state.level += 1

            st.rerun()

        else:
            st.session_state.error = True

    if st.session_state.error:
        st.error("ACCESS DENIED. Опитай отново.")

    st.markdown("---")

